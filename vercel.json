{
  "version": 2,
  "buildCommand": "pip install -r requirements.txt",
  "devCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT",
  "installCommand": "pip install -r requirements.txt",
  "outputDirectory": "app",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app/main.py"
    }
  ],
  "env": {
    "WHISPER_MODEL": "tiny",
    "TRANSCRIPTION_DEVICE": "cpu"
  },
  "functions": {
    "app/main.py": {
      "maxDuration": 60
    }
  }
}
